<Window x:Class="NumericCrossword.WinMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Победа!"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Градиент: от фиолетового к ярко-оранжевому -->
    <Border CornerRadius="25"
            Padding="30"
            BorderBrush="#AAFFFFFF"
            BorderThickness="2">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5D3A9B" Offset="0"/>
                <GradientStop Color="DeepPink" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Салют на фоне -->
            <Canvas x:Name="FireworksCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Крупная эмодзи-медаль -->
                <TextBlock 
                           FontSize="60"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Заголовок крупнее -->
                <TextBlock x:Name="MessageText"
                           Text="УРА! КРОССВОРД РЕШЁН!"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- Панель результатов (скрыта по умолчанию) -->
                <Border x:Name="ResultsPanel"
        Visibility="Collapsed"
        Background="#40FFFFFF"
        CornerRadius="15"
        Padding="20"
        Margin="0,0,0,25">
                    <StackPanel>
                        <!-- заголовки столбцов -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                       Text="Игрок"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#FFD700"/>
                            <TextBlock Grid.Column="1"
                       Text="Очки"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#FFD700"
                       Margin="20,0"/>
                            <TextBlock Grid.Column="2"
                       Text="Время"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#FFD700"/>
                        </Grid>

                        <!-- строки результатов -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="350">
                            <StackPanel x:Name="ResultsList"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>


                <!-- Кнопка ОК — крупная, яркая -->
               <Button Content="OK"
        FontSize="22"
        FontWeight="SemiBold"
        Foreground="White"
        Background="#33FFFFFF"
        BorderBrush="#88FFFFFF"
        BorderThickness="1"
        Padding="40,10"
        Cursor="Hand"
        Click="Ok_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
