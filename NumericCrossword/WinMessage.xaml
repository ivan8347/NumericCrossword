<Window x:Class="NumericCrossword.WinMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="420" Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid x:Name="RootGrid">

        <!-- Основная рамка -->
        <Border CornerRadius="25"
                BorderBrush="#55FFFFFF"
                BorderThickness="2"
                Padding="0">

            <!-- Переливающийся фон -->
            <Border CornerRadius="25">
                <Border.Background>
                    <LinearGradientBrush x:Name="AnimatedBrush"
                                         StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF6A00" Offset="0"/>
                        <GradientStop Color="#FF0099" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Border>

        <!-- Текст -->
        <TextBlock x:Name="MessageText"
                   Text="Победа!"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,20,0,60"/>

        <!-- Кнопка OK -->
        <Button Content="OK"
                Width="120" Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Click="Ok_Click"
                Background="#AA000000"
                Foreground="White"
                FontSize="18"
                BorderThickness="0"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.8"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Background" Value="#FF222222"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Салют -->
        <Canvas x:Name="FireworksCanvas"
                IsHitTestVisible="False"/>

        <!-- Анимация градиента -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <ColorAnimation Storyboard.TargetName="AnimatedBrush"
                                        Storyboard.TargetProperty="GradientStops[0].Color"
                                        To="#FF00C3FF"
                                        Duration="0:0:3"/>
                        <ColorAnimation Storyboard.TargetName="AnimatedBrush"
                                        Storyboard.TargetProperty="GradientStops[1].Color"
                                        To="#FFFF00D4"
                                        Duration="0:0:3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

    </Grid>
</Window>
