<Window x:Class="NumericCrossword.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numeric Crossword"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="Pink">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <Button x:Name="BtnNewGame"
                  Content="Новая игра"
                  Width="140"
                  Height="40"
                  Margin="0 0 10 0"
                  Click="BtnNewGame_Click"/>
            <Button x:Name="BtnUndo"
                  Content="Отмена"
                  Width="100"
                  Height="40"
                  Margin="0 0 10 0"
                  Click="BtnUndo_Click"/>

            <ComboBox x:Name="DifficultyBox"
                 Width="140"
                 Height="40"
                 SelectedIndex="0"
                 Margin="0 0 10 0"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center">
                <ComboBoxItem Content="Лёгкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Сложный"/>
            </ComboBox>


            <TextBlock Text="Время:"
                       VerticalAlignment="Center"
                       FontSize="18"
                       Margin="20 0 5 0"/>

            <TextBlock x:Name="TimerText"
                       VerticalAlignment="Center"
                       FontSize="18"
                       Text="00:00"/>
        </StackPanel>

        <!-- Сетка 15×15 -->
        <Border Grid.Row="1"
                BorderBrush="White"
                BorderThickness="6"
                CornerRadius="10"
                Padding="5">
          
            <Grid x:Name="CrosswordGrid"
                  Background="Pink">
                <!-- Сетка создаётся в коде -->
            </Grid>
        </Border>

        <!-- Плитки -->
        <Border Grid.Row="2"
                BorderBrush="#FFCCCCCC"
                BorderThickness="2"
                CornerRadius="6"
                Padding="10"
                Background="#FFF0F0F0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="TilesPanel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ItemWidth="60"
                           ItemHeight="60"
                           Margin="5">
                    <!-- Плитки создаются в коде -->
                </WrapPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
