<Window x:Class="NumericCrossword.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numeric Crossword" Height="730" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#FFE8C8D8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0" VerticalAlignment="Center">

            <Button x:Name="BtnNewGame"
                    Content="Новая игра"
                    Width="120" Height="40"
                    Margin="5"
                    Click="BtnNewGame_Click"/>

            <Button x:Name="BtnUndo"
                    Content="Отмена"
                    Width="120" Height="40"
                    Margin="5"
                    Click="BtnUndo_Click"/>
            
            <ComboBox x:Name="DifficultyBox"
                 Width="120" Height="40"
                 Margin="5"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center">
                <ComboBoxItem Content="Лёгкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Сложный"/>
            </ComboBox>




            <TextBlock Text="Время:" Margin="20,0,5,0"
                       VerticalAlignment="Center"
                       FontSize="20"/>

            <TextBlock x:Name="TimerText"
                       Text="00:00"
                       VerticalAlignment="Center"
                       FontSize="20"/>
        </StackPanel>

        <!-- Основная область: поле + плитки -->
        <Grid Grid.Row="1" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Поле -->
            <Grid x:Name="CrosswordGrid"
                  Grid.Column="0"
                  Background="White"
                  Margin="0,0,10,0"/>

            <!-- Плитки справа -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="TilesPanel"
                           Orientation="Horizontal"
                           Margin="5"/>
            </ScrollViewer>

        </Grid>

    </Grid>
</Window>
