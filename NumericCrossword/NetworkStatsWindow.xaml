<Window x:Class="NumericCrossword.NetworkStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сетевая статистика" Height="400" Width="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Результаты сетевой игры"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 10"/>
        <DataGrid x:Name="StatsGrid"
          Grid.Row="1"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          CanUserAddRows="False"
          IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Игрок" Binding="{Binding PlayerName}" Width="*"/>
                <DataGridTextColumn Header="Очки" Binding="{Binding Score}" Width="80"/>
                <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="80"/>
            </DataGrid.Columns>

        </DataGrid>


        <Button Grid.Row="2"
                Content="OK"
                Width="100"
                Height="35"
                HorizontalAlignment="Center"
                Margin="0 10 0 0"
                Click="BtnOk_Click"/>
    </Grid>
</Window>
