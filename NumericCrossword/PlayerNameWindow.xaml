<Window x:Class="NumericCrossword.PlayerNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        Width="300" Height="180"
        WindowStyle="None"
        Background="#FF1E1E1E"
        AllowsTransparency="True">

    <Border CornerRadius="15" BorderBrush="#55FFFFFF" BorderThickness="2" Padding="20">
        <StackPanel>
            <TextBlock Text="Введите имя игрока"
                       FontSize="22"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 10"/>

            <TextBox x:Name="NameBox"
                     FontSize="18"
                     Margin="0 0 0 15"/>

            <Button Content="OK"
                    Width="100"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="Ok_Click"/>
        </StackPanel>
    </Border>
</Window>
