<Window x:Class="NumericCrossword.RatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="600" Height="550"
        WindowStartupLocation="CenterOwner">

    <Border CornerRadius="20" Background="#FF1E1E1E" BorderBrush="#55FFFFFF" BorderThickness="2" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Рейтинг игроков" FontSize="32" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0 0 0 20"/>

            <!-- Сетевой рейтинг -->
            <TextBlock Grid.Row="1" Text="Сетевой рейтинг (сервер)" FontSize="20" FontWeight="SemiBold"
                       Foreground="#AAAAAA" Margin="0 0 0 10"/>
            <ListBox x:Name="ListScoresNetwork" Grid.Row="1" Grid.RowSpan="1"
                     Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Place}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding PlayerName}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Score}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding TimeSeconds}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding Difficulty}" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                            <TextBlock Grid.Column="5" Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Разделитель -->
            <Separator Grid.Row="2" Margin="0 15" Background="#333333"/>

            <!-- Локальный топ-5 -->
            <TextBlock Grid.Row="3" Text="Локальный топ‑5 (диск)" FontSize="20" FontWeight="SemiBold"
                       Foreground="#AAAAAA" Margin="0 0 0 10"/>
            <ListBox x:Name="ListScoresLocal" Grid.Row="3" Grid.RowSpan="1"
                     Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Place}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding PlayerName}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Score}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding TimeFormatted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding Difficulty}" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Кнопки -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                <Button Content="OK" Width="140" Height="40" Margin="0 0 10 0"
                        Click="Ok_Click" Background="#AA000000" Foreground="White" BorderThickness="0"/>
                <Button x:Name="BtnClearLocal" Content="Очистить локальный кэш"
                        Width="160" Height="40" Click="BtnClearLocal_Click"
                        Background="#AAFF4444" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
