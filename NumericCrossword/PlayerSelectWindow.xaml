<Window x:Class="NumericCrossword.PlayerSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Width="350" Height="450"
        WindowStyle="None"
        Background="#FF1E1E1E"
        AllowsTransparency="True">

    <Border BorderBrush="#55FFFFFF" BorderThickness="2" Padding="20">
        <StackPanel>

            <TextBlock Text="Выбор игрока"
                       FontSize="26"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 15"/>

            <ListBox x:Name="ListPlayers"
                     FontSize="20"
                     Height="220"
                     Margin="0 0 0 10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                <Button Content="Добавить" Width="100"  Height="40"   Margin="5" Click="Add_Click"/>
                <Button Content="Удалить" Width="100"   Height="40"   Margin="5" Click="Delete_Click"/>
            </StackPanel>

            <Button Content="Выбрать"
                    Width="120"
                    Height="40"
                    HorizontalAlignment="Center"
                    Margin="0 15 0 0"
                    Click="Select_Click"/>

        </StackPanel>
    </Border>
</Window>
