<Window x:Class="NumericCrossword.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Width="400" Height="500">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Список сообщений -->
        <ListBox x:Name="ChatList" Grid.Row="0" />

        <!-- Панель смайликов -->
        <ScrollViewer x:Name="EmojiPanel"
              Grid.Row="1"
              Visibility="Collapsed"
              MaxHeight="160"
              VerticalScrollBarVisibility="Auto"
              Margin="0,5,0,5"
              HorizontalScrollBarVisibility="Disabled">

            <StackPanel>
                <!-- Группа: Эмоции -->
                <TextBlock Text="Эмоции" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😀" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😂" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😊" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😍" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😎" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤔" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😴" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😢" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😡" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🥳" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😌" Click="Emoji_Click"/>
                </WrapPanel>

                <!-- Группа: Жесты и поддержка -->
                <TextBlock Text="Поддержка" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👍" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👎" Click="EmojiButtonStyle" Click="Emoji_Click"/>
                    <!-- Опечатка в Content выше, исправлено ниже -->
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👏" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🙌" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💪" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤝" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="✌️" Click="Emoji_Click"/>
                </WrapPanel>

                <!-- Группа: Праздники -->
                <TextBlock Text="Праздники" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🎉" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🔥" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="❤️" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="✨" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🏆" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="⭐" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🥇" Click="Emoji_Click"/>
                </WrapPanel>

                <!-- Группа: Предметы -->
                <TextBlock Text="Разное" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🧩" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="⏰" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🎯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💡" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🚀" Click="Emoji_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>


        <!-- Поле ввода + кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBox x:Name="ChatInput" Width="260" Margin="0,5,5,0"/>

            <Button x:Name="EmojiButton"
                    Content="😊"
                    Width="40"
                    Margin="0,5,5,0"
                    Click="EmojiButton_Click"/>

            <Button Content="Отправить" Width="80" Click="Send_Click"/>
        </StackPanel>
    </Grid>
</Window>
