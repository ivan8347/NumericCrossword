<Window x:Class="NumericCrossword.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Width="400" Height="500">

    <Window.Resources>
        <!-- Стиль элемента списка: выравнивание и цвета -->
        <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- Убираем стандартную синюю подсветку выделения, чтобы чат выглядел чисто -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Моё сообщение — справа -->
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                </DataTrigger>
                <!-- Личное для меня — красным и жирным -->
                <DataTrigger Binding="{Binding IsPersonalForMe}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Список сообщений -->
        <ListBox x:Name="ChatList"
                 Margin="10"
                 Background="White"
                 ItemContainerStyle="{StaticResource ChatItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5,2" Padding="6,4" CornerRadius="6"
                            Background="{Binding IsMine, Converter={x:Null}}">
                        <StackPanel MaxWidth="320">
                            <WrapPanel>
                                <!-- Время -->
                                <TextBlock Text="{Binding Time}"
                                           FontSize="11"
                                           Foreground="#888"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Top"/>

                                <!-- Имя отправителя -->
                                <TextBlock Text="{Binding Sender}"
                                           FontWeight="Bold"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Top"/>

                                <!-- Адресат: "→ Вася" (виден только у личных) -->
                                <TextBlock Text="{Binding RecipientDisplay}"
                                           Foreground="DarkOrange"
                                           FontWeight="SemiBold"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Top"/>

                                <!-- Текст сообщения -->
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           VerticalAlignment="Top"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Панель смайликов -->
        <ScrollViewer x:Name="EmojiPanel"
              Grid.Row="1"
              Visibility="Collapsed"
              MaxHeight="160"
              VerticalScrollBarVisibility="Auto"
              Margin="0,5,0,5"
              HorizontalScrollBarVisibility="Disabled">

            <StackPanel>
                <!-- Группа: Эмоции -->
                <TextBlock Text="Эмоции" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😂" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😊" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😍" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😎" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤔" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😴" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😢" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😡" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🥳" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😌" Click="Emoji_Click"/>
                </WrapPanel>

                <TextBlock Text="Поддержка" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👍" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👎" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👏" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🙌" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💪" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤝" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="✌️" Click="Emoji_Click"/>
                </WrapPanel>

                <!-- Группа: Праздники -->
                <TextBlock Text="Праздники" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🎉" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🔥" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="❤️" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="✨" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🏆" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="⭐" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🥇" Click="Emoji_Click"/>
                </WrapPanel>

                <!-- Группа: Предметы -->
                <TextBlock Text="Разное" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🧩" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="⏰" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🎯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💡" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🚀" Click="Emoji_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Поле ввода + кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBox x:Name="ChatInput"
                     Width="260"
                     Margin="0,5,5,0"
                     KeyDown="ChatInput_KeyDown"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="EmojiButton"
                    Content="😊"
                    Width="40"
                    Margin="0,5,5,0"
                    Click="EmojiButton_Click"/>

            <Button Content="Отправить" Width="80" Click="Send_Click" />
        </StackPanel>
    </Grid>
</Window>
