<Window x:Class="NumericCrossword.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Width="400" Height="500">

    <Window.Resources>
        <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <!-- КЛЮЧЕВОЕ: привязка выравнивания к ContentPresenter -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Моё сообщение — справа -->
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                </DataTrigger>
                <!-- Личное для меня — красным и жирным -->
                <DataTrigger Binding="{Binding IsPersonalForMe}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Список сообщений -->
        <ListBox x:Name="ChatList"
                 Grid.Row="0"
                 Margin="0,0,0,5"
                 Background="White"
                 ItemContainerStyle="{StaticResource ChatItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5,2" Padding="6,4" CornerRadius="6">
                        <StackPanel MaxWidth="300">
                            <WrapPanel>
                                <TextBlock Text="{Binding Time}"
                               FontSize="11"
                               Foreground="#888"
                               Margin="0,0,6,0"
                               VerticalAlignment="Top"/>
                                <!-- Имя отправителя — КЛИКАБЕЛЬНОЕ: выбирает адресата -->
                                <TextBlock Text="{Binding Sender}"
                                           FontWeight="Bold"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Top"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="Sender_Click"/>

                                <!-- Адресат "→ XZ" (виден только у личных сообщений) -->
                                <TextBlock Text="{Binding RecipientDisplay}"
                                           Foreground="DarkOrange"
                                           FontWeight="SemiBold"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Top"/>

                                <!-- Текст сообщения -->
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           FontSize="14"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Панель смайликов -->
        <ScrollViewer x:Name="EmojiPanel"
              Grid.Row="1"
              Visibility="Collapsed"
              MaxHeight="160"
              VerticalScrollBarVisibility="Auto"
              Margin="0,5,0,5"
              HorizontalScrollBarVisibility="Disabled">

            <StackPanel>
                <TextBlock Text="Эмоции" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😂" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😊" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😍" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😎" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤔" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😴" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😢" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😡" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🥳" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😌" Click="Emoji_Click"/>
                </WrapPanel>

                <TextBlock Text="Поддержка" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👍" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👎" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👏" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🙌" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💪" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤝" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="✌️" Click="Emoji_Click"/>
                </WrapPanel>

                <TextBlock Text="Праздники" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🎉" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🔥" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="❤️" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="✨" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🏆" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="⭐" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🥇" Click="Emoji_Click"/>
                </WrapPanel>

                <TextBlock Text="Разное" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🧩" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="⏰" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🎯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💡" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🚀" Click="Emoji_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Индикатор выбранного адресата -->
        <StackPanel x:Name="RecipientIndicator"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,3"
                    Visibility="Collapsed">
            <TextBlock x:Name="RecipientIndicatorText"
                       Text="Кому: "
                       FontWeight="SemiBold"
                       Foreground="DarkOrange"/>
            <Button Content="×"
                    Width="20" Height="20"
                    Padding="0,-3,0,0"
                    Margin="4,0,0,0"
                    Click="ClearRecipient_Click"
                    ToolTip="Отменить выбор адресата (отправить всем)"/>
        </StackPanel>

        <!-- Поле ввода + кнопки: Grid вместо StackPanel, чтобы ничего не обрезалось -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ChatInput"
                     Margin="0,5,5,0"
                     KeyDown="ChatInput_KeyDown"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="EmojiButton"
                    Grid.Column="1"
                    Content="😊"
                    Width="40"
                    Margin="0,5,5,0"
                    Click="EmojiButton_Click"/>

            <Button Grid.Column="2"
                    Content="Отправить"
                    MinWidth="80"
                    Margin="0,5,0,0"
                    Click="Send_Click"/>
        </Grid>
    </Grid>
</Window>
