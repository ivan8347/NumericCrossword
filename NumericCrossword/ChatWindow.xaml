<Window x:Class="NumericCrossword.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Width="400" Height="500">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Список сообщений -->
        <ListBox x:Name="ChatList" Margin="10" HorizontalContentAlignment="Stretch" Background="White">
            <DataTemplate>
                <TextBlock FontSize="16" TextWrapping="Wrap" Margin="0,2">
                <!-- Каждый Run отдельно — это обязательно! -->
                <Run FontFamily="Segoe UI Emoji" Text="["/>
                <Run FontFamily="Segoe UI Emoji" Text="{Binding Timestamp, StringFormat=HH\\:mm\\:ss}"/>
                <Run FontFamily="Segoe UI Emoji" Text="] "/>
                
                <Bold>
                    <Run FontFamily="Segoe UI Emoji" Text="{Binding Player}"/>
                </Bold>
                <Run FontFamily="Segoe UI Emoji" Text=": "/>
                
                <!-- Весь текст сообщения — отдельным Run с нужным шрифтом -->
                <Run FontFamily="Segoe UI Emoji" Text="{Binding Text}"/>
                </TextBlock>
            </DataTemplate>
        </ListBox>



        <!-- Панель смайликов -->
        <ScrollViewer x:Name="EmojiPanel"
              Grid.Row="1"
              Visibility="Collapsed"
              MaxHeight="160"
              VerticalScrollBarVisibility="Auto"
              Margin="0,5,0,5"
              HorizontalScrollBarVisibility="Disabled">

            <StackPanel>
                <!-- Группа: Эмоции -->
                <TextBlock Text="Эмоции" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <!--<Button Width="50" Height="50" Margin="5" Click="Emoji_Click" Tag="😀">
                        <Image Source="/Images/acute.png" Stretch="Uniform" Margin="5"/>-->


                        <Button x:Name="BeeButton" 
        Width="50" Height="50" Margin="5"
        Click="Emoji_Click" Tag="😀">
                            <Image Source="/Images/bee.png" 
           Stretch="Uniform" 
           Margin="5"/>
                        </Button>


                        <!--<Button Style="{StaticResource EmojiButtonStyle}" Content="😂" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😊" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😍" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😎" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤔" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😴" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😢" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😡" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🥳" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="😌" Click="Emoji_Click"/>-->
                </WrapPanel>


                <TextBlock Text="Поддержка" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👍" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👎" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="👏" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🙌" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💪" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🤝" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="✌️" Click="Emoji_Click"/>
                </WrapPanel>

                <!-- Группа: Праздники -->
                <TextBlock Text="Праздники" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🎉" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🔥" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="❤️" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="✨" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🏆" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="⭐" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🥇" Click="Emoji_Click"/>
                </WrapPanel>

                <!-- Группа: Предметы -->
                <TextBlock Text="Разное" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="13"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🧩" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="⏰" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🎯" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="💡" Click="Emoji_Click"/>
                    <Button Style="{StaticResource EmojiButtonStyle}" Content="🚀" Click="Emoji_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>


        <!-- Поле ввода + кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBox x:Name="ChatInput" 
      Width="260" 
      Margin="0,5,5,0" 
      KeyDown="ChatInput_KeyDown"
      VerticalContentAlignment="Center"/>

            <Button x:Name="EmojiButton"
                    Content="😊"
                    Width="40"
                    Margin="0,5,5,0"
                    Click="EmojiButton_Click"/>

            <Button Content="Отправить" Width="80" Click="Send_Click" />
        </StackPanel>
    </Grid>
</Window>
