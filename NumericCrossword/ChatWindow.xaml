<Window x:Class="NumericCrossword.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NumericCrossword"
        mc:Ignorable="d"

        Title="Чат" Width="400" Height="500">
    
    
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox x:Name="ChatList" Grid.Row="0" />

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBox x:Name="ChatInput" Width="300" Margin="0,5,5,0"/>
                <Button Content="Отправить" Width="80" Click="Send_Click"/>
            </StackPanel>
        </Grid>
    
</Window>
