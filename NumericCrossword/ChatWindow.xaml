<Window x:Class="NumericCrossword.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Width="400" Height="500">

    <Window.Resources>
        <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Личное для меня — красным и жирным -->
                <DataTrigger Binding="{Binding IsPersonalForMe}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Содержимое сообщения: имя + адресат + текст -->
        <DataTemplate x:Key="MessageContent">
            <StackPanel>
                <!-- Первая строка: имя и адресат -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Sender}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               MouseLeftButtonDown="Sender_Click"/>

                    <TextBlock Text="{Binding RecipientDisplay}"
                               FontSize="20"
                               Foreground="DarkOrange"
                               FontWeight="SemiBold"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Вторая строка: текст с картинками-эмодзи.
                     Loaded обязателен: DataContextChanged может не сработать,
                     если DataContext был установлен до загрузки в дерево. -->
                <TextBlock FontSize="20"
                           DataContextChanged="MessageText_DataContextChanged"
                           Loaded="MessageText_Loaded"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           VerticalAlignment="Top"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Список сообщений -->
        <ListBox x:Name="ChatList"
                 Grid.Row="0"
                 Margin="0,0,0,5"
                 Background="White"
                 HorizontalContentAlignment="Stretch"
                 ItemContainerStyle="{StaticResource ChatItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5,2">
                        <Grid.ColumnDefinitions>
                            <!-- Время: всегда слева -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Сообщение -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Время в скобках -->
                        <TextBlock Grid.Column="0"
                                   FontSize="12"
                                   Foreground="#888"
                                   Margin="0,10,6,0"
                                   VerticalAlignment="Top">
                            <Run Text="["/><Run Text="{Binding Time, Mode=OneWay}"/><Run Text="] "/>
                        </TextBlock>

                        <!-- Пузырь: все слева, свои подкрашены жёлтым.
                             Background задан только через стиль, не атрибутом. -->
                        <Border Grid.Column="1"
        CornerRadius="6"
        MaxWidth="340"
        Padding="6,4"
        HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <!-- Свои — жёлтый -->
                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="Background" Value="#FFF3B0"/>
                                        </DataTrigger>
                                        <!-- Личное для меня — голубой (идёт ПОСЛЕ жёлтого, значит побеждает при совпадении) -->
                                        <DataTrigger Binding="{Binding IsPersonalForMe}" Value="True">
                                            <Setter Property="Background" Value="LightSkyBlue"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentControl Content="{Binding}"
                    ContentTemplate="{StaticResource MessageContent}"/>
                        </Border>

                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Панель смайликов -->
        <ScrollViewer x:Name="EmojiPanel"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      MaxHeight="160"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,5,0,5"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Эмоции" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="16"/>
                <WrapPanel>
                    
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="😂" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/air_kiss.gif" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="😊" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f60a.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="😍" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f60d.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="😎" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f60e.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🤔" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f914.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="😴" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f634.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="😢" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f622.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="😡" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f621.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🤯" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f92f.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🥳" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f973.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="😌" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f60c.png" Width="32" Height="32"/>
                    </Button>
                </WrapPanel>


                <TextBlock Text="Поддержка" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="16"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="👍" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f44d.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="👎" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f44e.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="👏" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f44f.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🙌" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f64c.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="💪" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f4aa.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🤝" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f91d.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="✌️" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/270c.png" Width="32" Height="32"/>
                    </Button>

                </WrapPanel>
                <TextBlock Text="Праздники" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="16"/>
                <WrapPanel>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🎉" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f389.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🔥" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f525.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="❤️" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/2764.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="✨" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/2728.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🏆" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f3c6.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="⭐" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/2b50.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🥇" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f947.png" Width="32" Height="32"/>
                    </Button>
                </WrapPanel>

                <TextBlock Text="Разное" FontWeight="Bold" Foreground="#333" Margin="2,10,0,5" FontSize="16"/>
                <WrapPanel>
                    
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="⏰" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/23f0.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🎯" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f3af.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="💡" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f4a1.png" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource EmojiButtonStyle}" Tag="🚀" Click="Emoji_Click">
                        <Image Source="/Images/Emoji/1f680.png" Width="32" Height="32"/>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Индикатор выбранного адресата -->
        <StackPanel x:Name="RecipientIndicator"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,3"
                    Visibility="Collapsed">
            <TextBlock x:Name="RecipientIndicatorText"
                       Text="Кому: "
                       FontWeight="SemiBold"
                       Foreground="DarkOrange"/>
            <Button Content="×"
                    Width="20" Height="20"
                    Padding="0,-3,0,0"
                    Margin="4,0,0,0"
                    Click="ClearRecipient_Click"
                    ToolTip="Отменить выбор адресата (отправить всем)"/>
        </StackPanel>

        <!-- Поле ввода + кнопки -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ChatInput"
                     Margin="0,5,5,0"
                     KeyDown="ChatInput_KeyDown"
                     VerticalContentAlignment="Center"/>

            <!-- Кнопка эмодзи с картинкой -->
            <Button x:Name="EmojiButton"
                    Grid.Column="1"
                    Width="40"
                    Margin="0,5,5,0"
                    Click="EmojiButton_Click">
                <Image Source="/Images/Emoji/acute.png" Width="32" Height="32" Stretch="Uniform"/>
            </Button>

            <Button Grid.Column="2"
                    Content="Отправить"
                    MinWidth="80"
                    Margin="0,5,0,0"
                    Click="Send_Click"/>
        </Grid>
    </Grid>
</Window>
